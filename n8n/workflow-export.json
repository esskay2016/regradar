        "messages": {
          "values": [
            {
              "content": "=You are a regulatory intelligence analyst for a fintech company.\n\nAnalyze the following regulatory update and return a structured response:\n\nTitle: {{ $json.title }}\nContent: {{ $json.contentSnippet }}\nSource URL: {{ $json.link }}\nPublished Date: {{ $json.pubDate }}\n\nReturn your analysis in this exact format:\n\nSUMMARY: [3-5 plain English sentences summarizing the regulatory update for busy executives]\nPRODUCT_AREAS: [comma separated: Payments, Deposits, Lending, Card Issuance, Digital Onboarding, AML/BSA, Consumer Protection, Data Privacy, Other]\nURGENCY: [Action Required, Monitor Closely, or Informational]\nSO_WHAT: [2 sentences explaining what the product team should do in response to this update]"
            }
          ]
        },
        "options": {}
      },
